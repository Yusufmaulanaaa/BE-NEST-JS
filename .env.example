PORT=3000
# Wajib: rahasia untuk menandatangani JWT (gunakan string acak panjang)
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=7d
# Asal yang diizinkan (pisahkan dengan koma). Gunakan domain aplikasimu di produksi.
CORS_ORIGIN=*
# Database: kosongkan DATABASE_URL untuk SQLite (file lokal). Isi untuk PostgreSQL.
SQLITE_PATH=hukumin.sqlite
# DATABASE_URL=postgres://user:password@localhost:5432/hukumin
# AI chatbot (opsional). Tanpa key, backend otomatis pakai balasan contoh (mock) supaya tetap bisa diuji.
# Provider: "anthropic" (default) atau "openai_compatible" (OpenAI/Ollama/LM Studio/vLLM yang kompatibel chat/completions).
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-3-5-haiku-latest
AI_BASE_URL=
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=30000
# Fallback kompatibel lama:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Dataset chatbot lokal (opsional). Taruh file gabungan di sini; backend auto-load.
CHAT_DATASET_PATH=data/chatbot-dataset.json
